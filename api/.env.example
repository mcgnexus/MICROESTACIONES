DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Base de PRUEBAS (rama de Neon). La usan acceptance y acceptance:phase13, que
# escriben y borran datos y se niegan a correr contra un host de PRODUCTION_DB_HOSTS.
# Déjala vacía solo mientras no exista la rama.
DATABASE_URL_TEST=
# Hosts de producción (separados por comas, pooled y directo). Activa el guardián
# que detiene migrate y retention. Solo local: no se versiona en .env.
PRODUCTION_DB_HOSTS=
PORT=8080
# Catálogo de campañas analíticas (máximo 30), nombres genéricos sin identificadores personales.
# Solo letras, guiones y guiones bajos. Vacío agrupa cualquier campaña como none.
ANALYTICS_CAMPAIGNS=
COOKIE_SECURE=true
SESSION_TTL_DAYS=7
FORECAST_INGEST_TOKEN=
AEMET_API_KEY=
# Ventana máxima de diferencia horaria entre una medición local y AEMET (1–60 min).
AEMET_COMPARISON_WINDOW_MINUTES=10

# Entrega de avisos. "manual" (recomendado en piloto) no envía WhatsApp: deja el
# aviso en la bandeja de administración para enviarlo a mano. Sin proveedor, los
# envíos quedan pendientes y terminan en failed (no se simula la entrega).
WHATSAPP_PROVIDER=manual          # manual | disabled | console | meta | twilio
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Plantillas aprobadas para el envío automático de WhatsApp (meta/twilio). La
# plataforma exige plantillas para iniciar conversación o escribir fuera de la
# ventana de 24 h; sin plantilla, el mensaje NO se manda como texto y queda en
# estado manual. El nombre debe existir y estar aprobado con la MISMA forma que
# usa el código. Las categorías y precios los confirma el proveedor al implantar.
WHATSAPP_TEMPLATE_VERIFICATION=   # authentication: parámetro = código
WHATSAPP_TEMPLATE_ALERT=          # utility: título, finca, estación, valor, momento
WHATSAPP_TEMPLATE_LEAD=           # utility: nombre
WHATSAPP_TEMPLATE_COMMERCIAL=     # marketing: título, cuerpo
WHATSAPP_TEMPLATE_TEST=           # utility: texto de prueba de administración
WHATSAPP_TEMPLATE_LANG=es         # idioma de todas las plantillas
WHATSAPP_TEMPLATE_VERIFICATION_BUTTON=none   # none | copy_code | url
# Twilio Content API (opcional): si se define el SID, el envío usa esa plantilla.
TWILIO_CONTENT_VERIFICATION=
TWILIO_CONTENT_ALERT=
TWILIO_CONTENT_LEAD=
TWILIO_CONTENT_COMMERCIAL=
TWILIO_CONTENT_TEST=

EMAIL_PROVIDER=disabled           # disabled | console | resend
RESEND_API_KEY=
EMAIL_FROM=TecRural <avisos@example.com>

OUTBOX_EVAL_INTERVAL_S=60
# Evaluación de los detectores de sistema (desconexión, batería baja).
SYSTEM_EVAL_INTERVAL_S=60
# El plan contratado no admite disparos continuos: por debajo de 30 s no se baja.
# Ver README → "Ejecución programada y latencia esperada".
# Disparo principal: planificador externo (n8n) llamando a
# POST /api/v1/maintenance/scheduler con CRON_SECRET cada pocos minutos
# (workflows en docs/n8n-planificador.json). Sin él no hay pasadas ni entrega.
# Respaldo opcional por tráfico: cualquier petición a la API da un empujón.
SCHEDULER_REQUEST_TICK=false
# Tamaño de lote por pasada en procesos largos. En serverless cada invocación
# procesa 1 fila por defecto; el disparo externo puede pedir más con
# `?outbox=N` (acotado a 1-20).
OUTBOX_BATCH_SIZE=20
# Secreto del planificador externo (n8n / crontab) para
# GET|POST /api/v1/maintenance/scheduler y GET /api/v1/maintenance/status.
# Vacío = endpoints desactivados (503).
CRON_SECRET=
# Diagnóstico del planificador. Cadencia esperada del disparador externo: con el
# código de verificación de 10 min, ≤ 3 min deja margen para varias pasadas.
# El latido se marca `stale` si supera max(3×intervalo, 300 s) sin correr.
EXPECTED_SCHEDULER_INTERVAL_S=180
# La cola se marca `blocked` si el pendiente accionable más viejo supera estos
# segundos (900 = 15 min).
OUTBOX_BLOCKED_S=900

# Servidor MCP para agentes de IA (OpenClaw, Hermes) en POST /mcp.
# Solo lectura y uso interno del administrador: los clientes autentican con
# `Authorization: Bearer <MCP_TOKEN>`. Vacío = endpoint desactivado (503).
MCP_TOKEN=

# Límites de toda llamada externa (Meta, Twilio, Resend, AEMET, Open-Meteo).
HTTP_TIMEOUT_MS=8000
HTTP_MAX_MS=15000

# Caducidad de los mensajes en cola. Un aviso o un código viejo no se envía.
ALERT_MESSAGE_TTL_MINUTES=240
VERIFICATION_TTL_MINUTES=10
COMMERCIAL_MESSAGE_TTL_MINUTES=10080

# Firma de los webhooks de entrega (aceptado ≠ entregado).
# WHATSAPP_APP_SECRET: App Secret de Meta para X-Hub-Signature-256.
# RESEND_WEBHOOK_SECRET: secreto SVIX del webhook de Resend.
WHATSAPP_APP_SECRET=
RESEND_WEBHOOK_SECRET=
# OTP_DEBUG=true solo en desarrollo: devuelve el código en la respuesta de verify.
# En producción se ignora aunque esté a "true".
OTP_DEBUG=false

# Acceso sin contraseña por enlace de un solo uso.
MAGIC_LINK_TTL_MINUTES=15
MAGIC_RESEND_COOLDOWN_SECONDS=60

# Teléfono de soporte público (se muestra en la landing y el panel).
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Aviso interno cuando entra una solicitud de piloto (vacío = no se envía).
ADMIN_NOTICE_EMAIL=

# Dominio público para canonical, Open Graph, robots.txt y sitemap.xml.
PUBLIC_SITE_URL=https://tecrural-microestacion.vercel.app

# Webhook de WhatsApp para procesar BAJA/STOP (token de verificación).
WHATSAPP_WEBHOOK_TOKEN=

# Ventana de desconexión prevista (hotspot móvil): el detector de conectividad
# no abre avisos de "sin comunicación" durante esta franja. Días 0=domingo.
# OFFLINE_WINDOW_DAYS vacío = sin ventana (detector siempre activo).
OFFLINE_WINDOW_DAYS=1-5
OFFLINE_WINDOW_START=16:30
OFFLINE_WINDOW_END=18:00
OFFLINE_WINDOW_TZ=Europe/Madrid

# Retención de datos: días antes de borrar leads no convertidos y envíos ya cerrados.
LEAD_RETENTION_DAYS=730
OUTBOX_RETENTION_DAYS=90

# El motor de avisos: los avisos de umbral local solo se muestran cuando el
# motor está comprobado en esta instalación. Ponlo a false hasta validarlo de
# extremo a extremo; administración sigue viéndolos para depurar.
ALERT_ENGINE_VERIFIED=true

# Fase 1 (evaluación): con ALERT_SEND_ENABLED=false el motor abre episodios
# visibles en la app pero NO encola envíos externos. Por defecto true.
ALERT_SEND_ENABLED=true
