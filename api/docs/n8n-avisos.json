{
  "name": "TecRural · Vigilancia de alertas y cola",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 2 }
          ]
        }
      },
      "id": "b2c3d4e5-0000-4000-8000-000000000001",
      "name": "Cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "url": "https://tecrural-microestacion.vercel.app/api/v1/maintenance/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.TECRURAL_CRON_SECRET }}" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "json" } },
          "timeout": 25000
        }
      },
      "id": "b2c3d4e5-0000-4000-8000-000000000002",
      "name": "Estado de alertas y cola",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 0]
    }
  ],
  "connections": {
    "Cada 2 minutos": {
      "main": [
        [
          { "node": "Estado de alertas y cola", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
